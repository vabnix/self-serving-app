# Copy to .env.local and fill in. Without GITHUB_TOKEN and GITHUB_REPOSITORY,
# requests are saved but the provisioning pipeline is not started.

# Fine-grained personal access token with "Actions: Read and write" on the
# repository that holds the provisioning workflow.
GITHUB_TOKEN=
# owner/repo of that repository.
GITHUB_REPOSITORY=
# Workflow file name and the branch to run it from.
GITHUB_WORKFLOW=provision.yml
GITHUB_WORKFLOW_REF=main
# Public base URL of the portal, e.g. https://<app>.azurewebsites.net. The
# workflow reports each request's result back to it. Leave empty on localhost.
PORTAL_URL=

# Database. With AZURE_SQL_CONNECTION_STRING set, requests are stored in Azure
# SQL, for example:
#   Server=tcp:<server>.database.windows.net,1433;Database=<db>;User Id=<user>;Password=<password>;Encrypt=true;Connection Timeout=60
# Otherwise they go to a local SQLite file (default data/portal.db).
AZURE_SQL_CONNECTION_STRING=
DATABASE_PATH=
