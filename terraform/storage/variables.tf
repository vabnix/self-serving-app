# Set by the provisioning workflow.

variable "request_id" {
  description = "Portal request ID."
  type        = string
}

# Sent by the portal. Names match the request form's Terraform inputs.

variable "template" {
  description = "Catalog template ID. Always \"storage\" for this module."
  type        = string
}

variable "name" {
  description = "Workload name the developer entered, as a slug."
  type        = string
}

variable "team" {
  description = "Owning team."
  type        = string
}

variable "environment" {
  description = "dev, staging or prod."
  type        = string
}

variable "technical_contact" {
  description = "Name of the technical point of contact."
  type        = string
}

variable "requester" {
  description = "Name of the signed-in user who submitted the request. Null for requests made before sign-in."
  type        = string
  default     = null
}

variable "expires_on" {
  description = "Date (YYYY-MM-DD) after which the resource may be removed."
  type        = string
  default     = null
}

variable "resource_group" {
  description = "Resource group the requester chose. The workflow creates it if it does not exist."
  type        = string
}

variable "resource_names" {
  description = "Azure resource names generated by the portal."
  type = object({
    storage_account = string
  })
}

variable "replication" {
  description = "Redundancy: LRS, ZRS or GRS."
  type        = string

  validation {
    condition     = contains(["LRS", "ZRS", "GRS"], var.replication)
    error_message = "replication must be LRS, ZRS or GRS."
  }
}

variable "access_tier" {
  description = "Default blob access tier: Hot or Cool."
  type        = string

  validation {
    condition     = contains(["Hot", "Cool"], var.access_tier)
    error_message = "access_tier must be Hot or Cool."
  }
}

variable "containers" {
  description = "Comma-separated blob container names to create."
  type        = string
  default     = ""
}

variable "enable_data_lake" {
  description = "Enable the hierarchical namespace (Data Lake Storage Gen2)."
  type        = bool
  default     = false
}

variable "enable_versioning" {
  description = "Enable blob versioning."
  type        = bool
  default     = false
}
